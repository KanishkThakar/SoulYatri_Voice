# =============================================================================
# SoulYatri Speech — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# --- LiveKit Server ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- faster-whisper STT ---
# Model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
# Device: cuda or cpu
WHISPER_DEVICE=cuda
# Compute type: float16, int8, int8_float16
WHISPER_COMPUTE_TYPE=float16

# --- edge-tts ---
# Hindi voices: hi-IN-SwaraNeural (female), hi-IN-MadhurNeural (male)
# English voices: en-IN-NeerjaNeural (female), en-IN-PrabhatNeural (male)
TTS_VOICE_HINDI=hi-IN-SwaraNeural
TTS_VOICE_ENGLISH=en-IN-NeerjaNeural

# --- Logging ---
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Session ---
SESSION_TIMEOUT_SECONDS=300
MAX_CONVERSATION_HISTORY=20

# =============================================================================
# SoulYatri — final_use.md service config boundaries (Phase 1C)
# =============================================================================
# New service contracts added alongside the existing baseline keys above.
# Nothing here is required to import the foundation (shared/contracts) on CPU.

# --- Memory: Postgres (profile / relational store — L4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soulyatri
POSTGRES_USER=soulyatri
POSTGRES_PASSWORD=change-me

# --- Memory: Qdrant (semantic vector store — L3) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=soulyatri_memory

# --- Memory: Redis (hot session cache — L2; already used by docker-compose) ---
REDIS_URL=redis://localhost:6379/0

# --- Memory: Embeddings (multilingual-e5) ---
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_DEVICE=cpu

# --- Speech-native core: Mimi codec (pending-human-pin, see docs/MODEL_LOCKS.md) ---
MIMI_MODEL_PATH=
MIMI_SAMPLE_RATE=24000
MIMI_DEVICE=cpu

# --- Speech-native core: Moshi runtime (pending-human-pin) ---
MOSHI_MODEL_PATH=
MOSHI_DEVICE=cpu
# When false (default in CPU/no-weights envs) the runtime uses graceful fallbacks.
MOSHI_ENABLED=false

# --- Fallback speech generation: CSM ---
CSM_MODEL_PATH=
CSM_ENABLED=false

# --- Client helper: sherpa-onnx (tiny local ASR/KWS/intent router) ---
SHERPA_ONNX_MODEL_PATH=

# --- Safety: watermarking (AudioSeal or equivalent — pending-human-pin) ---
WATERMARK_ENABLED=false
WATERMARK_MODEL_PATH=
WATERMARK_DETECT_THRESHOLD=0.5

# --- Safety: voice policy / consent ---
VOICE_CONSENT_REQUIRED=true
PROTECTED_VOICE_LIST_PATH=

# --- Safety: moderation ---
MODERATION_ENABLED=true
MODERATION_FAIL_CLOSED=true

# --- Indic STT fallback (AI4Bharat IndicConformer or equivalent) ---
INDIC_STT_MODEL_PATH=
INDIC_STT_ENABLED=false

# --- Observability (Phase 15A) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
