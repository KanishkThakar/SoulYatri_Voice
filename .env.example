# =============================================================================
# SoulYatri Speech — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# --- LiveKit Server ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- faster-whisper STT ---
# Model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
# Device: cuda or cpu
WHISPER_DEVICE=cuda
# Compute type: float16, int8, int8_float16
WHISPER_COMPUTE_TYPE=float16

# --- edge-tts ---
# Hindi voices: hi-IN-SwaraNeural (female), hi-IN-MadhurNeural (male)
# English voices: en-IN-NeerjaNeural (female), en-IN-PrabhatNeural (male)
TTS_VOICE_HINDI=hi-IN-SwaraNeural
TTS_VOICE_ENGLISH=en-IN-NeerjaNeural

# --- Logging ---
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Session ---
SESSION_TIMEOUT_SECONDS=300
MAX_CONVERSATION_HISTORY=20
